# Copy to .env before setup if you want different local names or job counts.
# Defaults use a different container/tag from the original experiment.
# ROBOTWIN_CHECKOUT_ID is calculated by the PowerShell scripts; do not set it here.
COMPOSE_PROJECT_NAME=robotwin-wsl-repro
ROBOTWIN_CONTAINER_NAME=robotwin-repro
ROBOTWIN_IMAGE=robotwin-wsl:repro
ROBOTWIN_BASE_IMAGE=docker.1ms.run/pytorch/pytorch:2.4.1-cuda12.1-cudnn9-devel@sha256:9057ed8f4550b37a9715e59ff484fa5502a34e94a5159e02d8174f55ca8be29b
ROBOTWIN_BUILD_JOBS=2
ROBOTWIN_CUDA_JOBS=2
